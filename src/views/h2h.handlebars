<link rel="stylesheet" href="/css/h2h.css" />
<div class="h2h-page">
<div class="page-header">
  <span class="eyebrow">Estadísticas</span>
  <h1>Enfrentamientos</h1>
</div>

<div class="records-tabs h2h-navigation" aria-label="Secciones de enfrentamientos">
  <button
    type="button"
    class="records-tab {{#if (eq view 'compare')}}active{{/if}}"
    data-tab="compare"
  >
    Comparar jugadores
  </button>
  <button
    type="button"
    class="records-tab {{#if (eq view 'history')}}active{{/if}}"
    data-tab="history"
  >
    Historial de jugador
  </button>
  <a
    type="button"
    href="/h2h?view=records&season={{selectedSeason}}"
    class="records-tab {{#if (eq view 'records')}}active{{/if}}"
  >
    Récords
  </a>
</div>

<div
  id="compare-section"
  {{#unless (eq view "compare")}}
    style="display:none;"
  {{/unless}}
>
  <div class="h2h-filters h2h-selection-card">
    <div class="h2h-selection-intro"><p>Dos jugadores, un historial.</p></div>
    <form method="GET" action="/h2h" class="h2h-form" id="h2h-compare-form">
      <input type="hidden" name="view" value="compare" />
      <div class="h2h-selects">
        <div class="h2h-select-wrapper">
          <label for="h2h-player-a" class="section-label-h2h">Primer jugador</label>
          <select id="h2h-player-a" name="playerA" class="season-filter-select">
            <option value="">Seleccionar jugador</option>
            {{#each players}}
            <option
              value="{{this._id}}"
              {{#if (eq (toString this._id) ../selectedPlayerA)}}selected{{/if}}
            >
              {{this.name}}
            </option>
            {{/each}}
          </select>
        </div>
        <div class="h2h-selection-middle"><span class="h2h-vs" id="h2h-comparison-separator">{{#if (eq mode "duo")}}&{{else}}VS{{/if}}</span></div>
        <div class="h2h-select-wrapper">
          <label for="h2h-player-b" class="section-label-h2h">Segundo jugador</label>
          <select id="h2h-player-b" name="playerB" class="season-filter-select">
            <option value="">Seleccionar jugador</option>
            {{#each players}}
            <option
              value="{{this._id}}"
              {{#if (eq (toString this._id) ../selectedPlayerB)}}selected{{/if}}
            >
              {{this.name}}
            </option>
            {{/each}}
          </select>
        </div>
      </div>
      <div class="h2h-options">
        <div class="h2h-mode-toggle">
          <button type="button" data-compare-mode="vs" aria-pressed="{{#if (eq mode 'vs')}}true{{else}}false{{/if}}" class="h2h-mode-btn {{#if (eq mode 'vs')}}active{{/if}}">Enfrentamiento</button>
          <button type="button" data-compare-mode="duo" aria-pressed="{{#if (eq mode 'duo')}}true{{else}}false{{/if}}" class="h2h-mode-btn {{#if (eq mode 'duo')}}active{{/if}}">Dupla</button>
        </div>
        <select name="season" class="season-filter-select" aria-label="Temporada de la comparación">
          <option value="all_time" {{#if (eq selectedSeason "all_time")}}selected{{/if}}>TODAS (AMAT + PROF)</option>
        <option value="all" {{#if (eq selectedSeason "all")}}selected{{/if}}>TODAS (PROFESIONALISMO)</option>
          <option value="2026" {{#if (eq selectedSeason "2026")}}selected{{/if}}>
            2026
          </option>
          <option value="2025" {{#if (eq selectedSeason "2025")}}selected{{/if}}>
            2025
          </option>
          <option value="2024" {{#if (eq selectedSeason "2024")}}selected{{/if}}>
            2024
          </option>
          <option value="2021" {{#if (eq selectedSeason "2021")}}selected{{/if}}>
            2021
          </option>
        </select>
        <input type="hidden" name="mode" value="{{mode}}" />
        <div class="h2h-btns">
          <a href="/h2h" class="btn btn-secondary h2h-clear-btn">
            Limpiar
          </a>
          <button type="submit" class="btn btn-primary">
            Comparar
          </button>
        </div>
      </div>
    </form>
  </div>
  <p id="h2h-compare-status" class="h2h-compare-status" role="status" hidden></p>
  <div id="h2h-compare-results">
  {{#if stats}}
  <div class="h2h-result-wrapper">
    <div class="h2h-result" id="h2h-result-card">
      {{#if (eq mode "vs")}}
      <div class="h2h-scoreboard">
        <div class="h2h-player {{#if (gt stats.winsA stats.winsB)}}h2h-player-winner{{/if}}">
          <span class="h2h-player-name">
            {{playerA.name}}
          </span>
          <span class="h2h-player-wins {{#if (gt stats.winsA stats.winsB)}}h2h-wins-highlight{{/if}}">
            {{stats.winsA}}
          </span>
          <span class="h2h-player-label">
            victorias
          </span>
        </div>
        <div class="h2h-center">
          <div class="h2h-center-stat">
            <span class="h2h-center-num">
              {{stats.played}}
            </span>
            <span class="h2h-center-label">
              partidos
            </span>
          </div>
          <div class="h2h-center-stat">
            <span class="h2h-center-num" style="color:var(--draw)">
              {{stats.draws}}
            </span>
            <span class="h2h-center-label">
              empates
            </span>
          </div>
        </div>
        <div class="h2h-player h2h-player-right {{#if (gt stats.winsB stats.winsA)}}h2h-player-winner{{/if}}">
          <span class="h2h-player-name">
            {{playerB.name}}
          </span>
          <span class="h2h-player-wins {{#if (gt stats.winsB stats.winsA)}}h2h-wins-highlight{{/if}}">
            {{stats.winsB}}
          </span>
          <span class="h2h-player-label">
            victorias
          </span>
        </div>
      </div>
      {{/if}}
      {{#if (eq mode "duo")}}
      <div class="h2h-duo-header">
        <span class="h2h-player-name">
          {{playerA.name}}
        </span>
        <span class="h2h-vs-label">
          &
        </span>
        <span class="h2h-player-name">
          {{playerB.name}}
        </span>
      </div>
      <div class="h2h-duo-grid">
        <div class="h2h-duo-stat h2h-duo-stat-lg">
          <strong>{{stats.played}}</strong>
          <span>Partidos</span>
        </div>
        <div class="h2h-duo-divider"></div>
        <div class="h2h-duo-stat">
          <strong style="color:var(--win)">{{stats.wins}}</strong>
          <span>Victorias</span>
        </div>
        <div class="h2h-duo-stat">
          <strong style="color:var(--draw)">{{stats.draws}}</strong>
          <span>Empates</span>
        </div>
        <div class="h2h-duo-stat">
          <strong style="color:var(--loss)">{{stats.losses}}</strong>
          <span>Derrotas</span>
        </div>
        <div class="h2h-duo-divider"></div>
        <div class="h2h-duo-stat h2h-duo-stat-lg">
          <strong style="color:var(--accent)">{{stats.winrate}}%</strong>
          <span>Winrate</span>
        </div>
      </div>
      {{/if}}
    </div>
    <button
      type="button"
      class="btn-match-action btn-copy h2h-copy-btn"
      onclick="copyH2H()"
      title="Copiar imagen"
    >
      <svg viewBox="0 0 24 24" width="16" height="16">
        <path d="M16 1H4C2.9 1 2 1.9 2 3v12h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
      </svg>
    </button>
  </div>
  {{/if}}
  {{#if stats.matches.length}}
  <div class="h2h-chart-card">
    <div class="h2h-chart-header">
      <span>{{#if (eq mode "duo")}}Evolución de la dupla{{else}}Evolución del H2H{{/if}}</span>
    </div>
    
    <canvas id="h2hChart" height="140" role="img" aria-label="{{#if (eq mode 'duo')}}Balance acumulado de victorias y derrotas de la dupla{{else}}Evolución de la diferencia de victorias entre los jugadores{{/if}}" data-mode="{{mode}}" data-player-a="{{playerA.name}}" data-player-b="{{playerB.name}}" data-matches="{{json stats.matches}}"></canvas>
  </div>
  {{/if}}
  {{#if stats}}
  <div class="h2h-matches-panel">
    <div class="h2h-matches">
      <p class="section-label h2h-matches-title">
        {{#if (eq mode "vs")}}
          Partidos enfrentados
        {{else}}
          Partidos juntos
        {{/if}}
      </p>
      {{#if stats.matches.length}}
      <div class="h2h-matches-list">
        {{#each stats.matches}}
        <a href="/matches?season=all#match-{{this._id}}" class="h2h-match-link">
          <div class="match-card match-card-compact">
            <div class="match-scoreboard
              {{#if (gt this.teamA this.teamB)}}scoreboard-win-a
              {{else if (gt this.teamB this.teamA)}}scoreboard-win-b
              {{else}}scoreboard-draw
              {{/if}}
            ">
              <div class="match-team">
                <span class="match-team-label">Equipo</span>
                <span class="match-team-name">Blanco</span>

                {{#if (or (eq this.teamOfA "A") (eq this.teamOfB "A"))}}
                  <span class="h2h-team-players">
                    {{#if (eq this.teamOfA "A")}}
                      <span class="h2h-team-player">{{../playerA.name}}</span>
                    {{/if}}
                    {{#if (eq this.teamOfB "A")}}
                      <span class="h2h-team-player">{{../playerB.name}}</span>
                    {{/if}}
                  </span>
                {{/if}}
              </div>
              <div class="match-score">
                <div class="match-date">
                  {{formatDate this.date}}
                </div>
                <span class="match-score-number">
                  {{this.teamA}} — {{this.teamB}}
                </span>
                {{#if this.venue}}
                <span class="match-score-meta">
                  {{this.venue}}
                </span>
                {{/if}}
              </div>
              <div class="match-team match-team-right">
                <span class="match-team-label">Equipo</span>
                <span class="match-team-name">Negro</span>

                {{#if (or (eq this.teamOfA "B") (eq this.teamOfB "B"))}}
                  <span class="h2h-team-players">
                    {{#if (eq this.teamOfA "B")}}
                      <span class="h2h-team-player">{{../playerA.name}}</span>
                    {{/if}}
                    {{#if (eq this.teamOfB "B")}}
                      <span class="h2h-team-player">{{../playerB.name}}</span>
                    {{/if}}
                  </span>
                {{/if}}
              </div>
            </div>
          </div>
        </a>
        {{/each}}
      </div>
      {{else}}
      <div class="list-empty-state">
        Sin partidos para mostrar
      </div>
      {{/if}}
    </div>
  </div>
  {{/if}}
  </div>
</div>

<div
  id="history-section"
  {{#unless (eq view "history")}}
    style="display:none;"
  {{/unless}}
>
  <div class="h2h-history-filters">
    <form method="GET" action="/h2h" class="h2h-form">
      <input type="hidden" name="view" value="history" />
      <div class="h2h-options">
        <div class="h2h-history-player"><label for="h2h-history-player" class="section-label-h2h">Jugador</label><select id="h2h-history-player" name="player" class="season-filter-select">
          <option value="">Seleccionar jugador</option>
          {{#each players}}
          <option
            value="{{this._id}}"
            {{#if (eq (toString this._id) ../selectedPlayer)}}selected{{/if}}
          >
            {{this.name}}
          </option>
          {{/each}}
        </select></div>
        <select name="season" class="season-filter-select">
          <option value="all_time" {{#if (eq selectedSeason "all_time")}}selected{{/if}}>TODAS (AMAT + PROF)</option>
        <option value="all" {{#if (eq selectedSeason "all")}}selected{{/if}}>TODAS (PROFESIONALISMO)</option>
          <option value="2026" {{#if (eq selectedSeason "2026")}}selected{{/if}}>
            2026
          </option>
          <option value="2025" {{#if (eq selectedSeason "2025")}}selected{{/if}}>
            2025
          </option>
          <option value="2024" {{#if (eq selectedSeason "2024")}}selected{{/if}}>
            2024
          </option>
          <option value="2021" {{#if (eq selectedSeason "2021")}}selected{{/if}}>
            2021
          </option>
        </select>
        <a href="/h2h?view=history" class="btn btn-secondary h2h-clear-btn">
          Limpiar
        </a>
        <button type="submit" class="btn btn-primary">
          Historial
        </button>
      </div>
    </form>
  </div>
  {{#if historyStats}}
  <div class="h2h-options">
    <div class="h2h-mode-toggle">
      <a href="?view=history&player={{selectedPlayer}}&historyMode=vs&season={{selectedSeason}}"
        class="h2h-mode-btn {{#if (eq historyMode 'vs')}}active{{/if}}"
      >
        Enfrentamientos
      </a>
      <a href="?view=history&player={{selectedPlayer}}&historyMode=duo&season={{selectedSeason}}"
        class="h2h-mode-btn {{#if (eq historyMode 'duo')}}active{{/if}}"
      >
        Duplas
      </a>
    </div>
    <div class="h2h-rival-filter" id="rivalFilterWrapper">
      <button type="button" class="btn btn-secondary h2h-rival-filter-btn" id="rivalFilterBtn">
        Filtrar por jugador
        <span class="h2h-rival-filter-count" id="rivalFilterCount" style="display:none;"></span>
      </button>
      <div class="h2h-rival-filter-panel" id="rivalFilterPanel">
        <button type="button" class="h2h-rival-filter-clear" id="rivalFilterClear">
          Limpiar selección
        </button>
        {{#each players}}
          {{#unless (eq (toString this._id) ../selectedPlayer)}}
          <label class="h2h-rival-filter-option">
            <input type="checkbox" class="rival-filter-checkbox" value="{{this._id}}" />
            {{this.name}}
          </label>
          {{/unless}}
        {{/each}}
      </div>
    </div>
  </div>
  <div class="product-list-section">
    <div class="product-list-header h2h-history-header">
      <span>#</span>
      <span>Jugador</span>

      <span class="sortable-header" data-sort="played">PJ</span>
      <span class="sortable-header" data-sort="wins">PG</span>
      <span class="sortable-header" data-sort="draws">PE</span>
      <span class="sortable-header" data-sort="losses">PP</span>
      <span class="sortable-header" data-sort="winrate">WR</span>
    </div>
    <ul class="product-list">
      {{#each historyStats}}
      <li class="product-row stat-row h2h-history-row"
          data-opponent-id="{{this.opponentId}}"
          data-played="{{this.played}}"
          data-wins="{{this.wins}}"
          data-draws="{{this.draws}}"
          data-losses="{{this.losses}}"
          data-winrate="{{this.winrate}}">
        <span class="col-num">
          {{add @index 1}}
        </span>
        <div class="col-title">
          <span class="product-row-title">
            {{this.opponent}}
          </span>
        </div>
        <span class="stat-cell">
          {{this.played}}
        </span>
        <span class="stat-cell cell-win">
          {{this.wins}}
        </span>
        <span class="stat-cell cell-draw">
          {{this.draws}}
        </span>
        <span class="stat-cell cell-loss">
          {{this.losses}}
        </span>
        <span class="stat-cell cell-goals">
          {{this.winrate}}%
        </span>
      </li>
      {{/each}}
    </ul>
  </div>
  {{else}}
  <div class="list-empty-state">
    Seleccioná un jugador para ver su historial
  </div>
  {{/if}}
</div>

<div
  id="records-section"
  data-loaded="{{#if (eq view 'records')}}true{{else}}false{{/if}}"
  {{#unless (eq view "records")}}
    style="display:none;"
  {{/unless}}
>
  <div class="h2h-records-filters">
    <form method="GET" action="/h2h" class="h2h-form">
      <input type="hidden" name="view" value="records" />
      <input type="hidden" name="recordsCategory" value="{{recordsCategory}}" />
      <select name="season" class="season-filter-select" onchange="this.form.submit()">
        <option value="all_time" {{#if (eq selectedSeason "all_time")}}selected{{/if}}>TODAS (AMAT + PROF)</option>
        <option value="all" {{#if (eq selectedSeason "all")}}selected{{/if}}>TODAS (PROFESIONALISMO)</option>
        <option value="2026" {{#if (eq selectedSeason "2026")}}selected{{/if}}>2026</option>
        <option value="2025" {{#if (eq selectedSeason "2025")}}selected{{/if}}>2025</option>
        <option value="2024" {{#if (eq selectedSeason "2024")}}selected{{/if}}>2024</option>
        <option value="2021" {{#if (eq selectedSeason "2021")}}selected{{/if}}>2021</option>
      </select>
    </form>
  </div>

  <div class="h2h-options h2h-records-options">
    <div class="h2h-mode-toggle-records">
      <a href="?view=records&recordsCategory=h2h&season={{selectedSeason}}"
        data-records-category="h2h"
        class="h2h-mode-btn {{#if (eq recordsCategory 'h2h')}}active{{/if}}"
      >
        Mayores dif H2H
      </a>
      <a href="?view=records&recordsCategory=duos&season={{selectedSeason}}"
        data-records-category="duos"
        class="h2h-mode-btn {{#if (eq recordsCategory 'duos')}}active{{/if}}"
      >
        Mejores duplas
      </a>
    </div>
  </div>

  <div class="records-content">
    <div class="records-category {{#if (eq recordsCategory 'h2h')}}active{{/if}}" data-category="h2h-records"
      {{#unless (eq recordsCategory "h2h")}}style="display:none;"{{/unless}}
    >
      <div class="records-section">
        <div class="h2h-list-section">
          <div class="h2h-list-header">
            <span class="col-num">#</span>
            <span class="h2h-col-player h2h-sortable" data-sort="player">Jugador</span>
            <span class="h2h-col-rival h2h-sortable" data-sort="rival">Rival</span>
            <span class="h2h-col-stat h2h-sortable" data-sort="played">PJ</span>
            <span class="h2h-col-stat h2h-sortable" data-sort="wins">PG</span>
            <span class="h2h-col-stat h2h-sortable" data-sort="draws">PE</span>
            <span class="h2h-col-stat h2h-sortable" data-sort="losses">PP</span>
            <span class="h2h-col-dif h2h-sortable h2h-sort-active" data-sort="diff">DIF</span>
          </div>
          <ul class="h2h-list">
            {{#each biggestH2HDiffs}}
              <li>
                <div class="h2h-list-row stat-row"
                    data-played="{{this.played}}"
                    data-wins="{{this.dominantWins}}"
                    data-draws="{{this.draws}}"
                    data-losses="{{this.dominatedWins}}"
                    data-diff="{{this.diff}}"
                    data-player="{{this.dominantPlayer}}"
                    data-rival="{{this.dominatedPlayer}}">
                  <span class="col-num">{{add @index 1}}</span>
                  <div class="h2h-col-player col-title">
                    <span class="product-row-title">{{this.dominantPlayer}}</span>
                  </div>
                  <div class="h2h-col-rival col-title">
                    <span class="product-row-title h2h-rival-name">{{this.dominatedPlayer}}</span>
                  </div>
                  <span class="h2h-col-stat stat-cell">{{this.played}}</span>
                  <span class="h2h-col-stat stat-cell cell-win">{{this.dominantWins}}</span>
                  <span class="h2h-col-stat stat-cell cell-draw">{{this.draws}}</span>
                  <span class="h2h-col-stat stat-cell cell-loss">{{this.dominatedWins}}</span>
                  <span class="h2h-col-dif stat-cell h2h-dif-cell">+{{this.diff}}</span>
                </div>
              </li>
            {{else}}
              <li class="list-empty-state">Sin datos suficientes para esta temporada</li>
            {{/each}}
          </ul>
        </div>
      </div>
      <section class="h2h-balanced" aria-labelledby="h2h-balanced-title">
        <h2 id="h2h-balanced-title">Enfrentamientos igualados</h2>
        <div class="h2h-list-section" data-default-sort="played">
          <div class="h2h-list-header">
            <span class="col-num">#</span>
            <span class="duo-col-players">Jugadores</span>
            <span class="h2h-col-stat h2h-sortable h2h-sort-active" data-sort="played">PJ</span>
            <span class="h2h-col-stat h2h-sortable" data-sort="wins">PG</span>
            <span class="h2h-col-stat h2h-sortable" data-sort="draws">PE</span>
            <span class="h2h-col-stat h2h-sortable" data-sort="losses">PP</span>
            <span class="h2h-col-dif">DIF</span>
          </div>
          <ul class="h2h-list">
            {{#each balancedH2Hs}}
            <li>
              <div class="h2h-list-row stat-row" data-player="{{this.playerA}}" data-rival="{{this.playerB}}" data-played="{{this.played}}" data-wins="{{this.winsA}}" data-draws="{{this.draws}}" data-losses="{{this.winsB}}" data-diff="0">
                <span class="col-num">{{add @index 1}}</span>
                <div class="duo-col-players col-title"><span class="product-row-title">{{this.playerA}} <span class="h2h-pair-vs">vs</span> {{this.playerB}}</span></div>
                <span class="h2h-col-stat stat-cell">{{this.played}}</span>
                <span class="h2h-col-stat stat-cell cell-win">{{this.winsA}}</span>
                <span class="h2h-col-stat stat-cell cell-draw">{{this.draws}}</span>
                <span class="h2h-col-stat stat-cell cell-loss">{{this.winsB}}</span>
                <span class="h2h-col-dif stat-cell h2h-dif-cell">0</span>
              </div>
            </li>
            {{else}}
            <li class="list-empty-state">No hay enfrentamientos igualados con al menos 5 partidos en esta temporada.</li>
            {{/each}}
          </ul>
        </div>
      </section>
    </div>

    <div class="records-category {{#if (eq recordsCategory 'duos')}}active{{/if}}" data-category="duo-records"
      {{#unless (eq recordsCategory "duos")}}style="display:none;"{{/unless}}
    >
      <div class="records-section">
        <div class="h2h-list-section">
          <div class="duo-list-header">
            <span class="col-num">#</span>
            <span class="duo-col-players">Dupla</span>
            <span class="duo-col-stat h2h-sortable" data-sort="played">PJ</span>
            <span class="duo-col-stat h2h-sortable" data-sort="wins">PG</span>
            <span class="duo-col-stat h2h-sortable" data-sort="draws">PE</span>
            <span class="duo-col-stat h2h-sortable" data-sort="losses">PP</span>
            <span class="duo-col-wr h2h-sortable h2h-sort-active" data-sort="wr">%</span>
          </div>
          <ul class="duo-list">
            {{#each bestDuos}}
              <li>
                <div class="duo-list-row stat-row"
                  data-played="{{this.played}}"
                  data-wins="{{this.wins}}"
                  data-draws="{{this.draws}}"
                  data-losses="{{this.losses}}"
                  data-wr="{{this.winrate}}"
                >
                  <span class="col-num">{{add @index 1}}</span>
                  <div class="duo-col-players col-title">
                    <span class="product-row-title">{{this.playerA}} & {{this.playerB}}</span>
                  </div>
                  <span class="duo-col-stat stat-cell">{{this.played}}</span>
                  <span class="duo-col-stat stat-cell cell-win">{{this.wins}}</span>
                  <span class="duo-col-stat stat-cell cell-draw">{{this.draws}}</span>
                  <span class="duo-col-stat stat-cell cell-loss">{{this.losses}}</span>
                  <span class="duo-col-wr stat-cell h2h-dif-cell">{{this.winrate}}</span>
                </div>
              </li>
            {{else}}
              <li class="list-empty-state">Sin datos suficientes para esta temporada</li>
            {{/each}}
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const allTabs = document.querySelectorAll(".records-tab");
  const clickableTabs = document.querySelectorAll(".records-tab[data-tab]");

  const compareSection = document.getElementById("compare-section");
  const historySection = document.getElementById("history-section");
  const recordsSection = document.getElementById("records-section");

  clickableTabs.forEach(tab => {
    tab.addEventListener("click", () => {
      allTabs.forEach(t => t.classList.remove("active"));
      tab.classList.add("active");

      const target = tab.dataset.tab;

      compareSection.style.display = target === "compare" ? "block" : "none";
      historySection.style.display = target === "history" ? "block" : "none";
      recordsSection.style.display = "none";
    });
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script>
async function copyH2H() {
  const element = document.getElementById("h2h-result-card");

  const canvas = await html2canvas(element, {
    scale: 2,
    useCORS: true
  });

  canvas.toBlob(async (blob) => {
    try {
      await navigator.clipboard.write([
        new ClipboardItem({
          "image/png": blob
        })
      ]);

      showToast("✓ Imagen copiada", "success");
    } catch (err) {
      console.error(err);

      showToast("No se pudo copiar la imagen", "error");
    }
  });
}
</script>
</div>
