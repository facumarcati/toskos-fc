<link rel="stylesheet" href="/css/home.css" />

<main class="home-start">
  <section class="home-intro" aria-labelledby="home-title">
    <div class="home-copy">
      <p class="home-kicker"><span></span> 2017 - 2026</p>
      <h1 id="home-title">Toskos<span>FC</span></h1>
      <p class="home-description">Partidos, estadísticas y rivalidades.</p>
      <div class="home-cta">
        <a href="/matches" class="btn home-action home-action--matches">Ver partidos
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
        <a href="/stats" class="btn home-action home-action--stats">Estadísticas
          <svg class="home-stats-icon" aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M5 19V13" /><path d="M12 19V5" /><path d="M19 19V9" /></svg></a>
      </div>
    </div>
    <div class="home-emblem" aria-hidden="true">
      <div class="home-emblem-orbit"></div>
      <img
        src="/img/escudo-tsk.png"
        alt=""
        width="300"
        height="300"
        fetchpriority="high"
      />
      <div class="home-rivalry"><span
          class="home-shirt home-shirt-white"
        ></span>
        Blanco
        <span class="home-rivalry-vs">vs</span>
        Negro
        <span class="home-shirt home-shirt-black"></span></div>
    </div>
  </section>
</main>
