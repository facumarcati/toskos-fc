<link rel="stylesheet" href="/css/playerProfile.css" />

<div class="page-header">
  <span class="eyebrow">
    Perfil de jugador
  </span>
  <h1 class="player-name" id="playerNameWrapper">
    <span id="playerNameText">
      {{player.name}}
    </span>
    <button
      class="btn-edit-name"
      id="editNameBtn"
      data-player="{{player._id}}"
    >
      ✏️
    </button>
  </h1>
  {{#if player.user}}
  <div class="player-username">
    <span id="usernameText">
      @{{player.user.username}}
    </span>
    {{#if (eq player.user._id currentUser._id)}}
    <button
      class="btn-edit-username"
      id="editUsernameBtn"
      data-player="{{player._id}}"
    >
      ✏️
    </button>
    {{/if}}
  </div>
  {{/if}}
  <label class="filter-checkbox" style="margin-top:8px; display:inline-flex;">
    <input
      type="checkbox"
      id="toggleGuest"
      {{#if player.guest}}checked{{/if}}
      onchange="updateGuestStatus('{{player._id}}', this.checked)"
    />
    Jugador invitado
  </label>
</div>

<div class="matches-header">
  <form method="GET" class="season-filter">
    <select name="season" onchange="this.form.submit()">
       <option value="all_time" {{#if (eq selectedSeason "all_time")}}selected{{/if}}>TODAS (AMAT + PROF)</option>
        <option value="all" {{#if (eq selectedSeason "all")}}selected{{/if}}>TODAS (PROFESIONALISMO)</option>
        {{#each seasons}}
        <option value="{{this}}" {{#if (eq ../selectedSeason (toString this))}}selected{{/if}}>{{this}}</option>
        {{/each}}
    </select>
  </form>
</div>

<div class="profile-layout">
  <div class="form-panel">
    <p class="section-label">
      Estadísticas
    </p>
    <div class="stats-grid">
      <div class="stat-box">
        <strong>{{stats.played}}</strong>
        <span>Partidos</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.winrate}}%</strong>
        <span>Winrate</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.goals}}</strong>
        <span>Goles</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.assists}}</strong>
        <span>Asist</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.ga}}</strong>
        <span>G+A</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.goalsPerMatch}}</strong>
        <span>Gol / P</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.gaPerMatch}}</strong>
        <span>G+A / P</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.wins}}</strong>
        <span>Victorias</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.draws}}</strong>
        <span>Empates</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.losses}}</strong>
        <span>Derrotas</span>
      </div>
    </div>
  </div>
</div>

<div class="profile-teams">
  <div class="form-panel">
    <p class="section-label">
      Equipo blanco
    </p>
    <div class="team-grid">
      <div class="stat-box">
        <strong>{{stats.white.played}}</strong>
        <span>PJ</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.white.wins}}</strong>
        <span>PG</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.white.draws}}</strong>
        <span>PE</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.white.losses}}</strong>
        <span>PP</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.white.winrate}}%</strong>
        <span>WR</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.white.goals}}</strong>
        <span>G</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.white.assists}}</strong>
        <span>A</span>
      </div>
    </div>
  </div>
  <div class="form-panel">
    <p class="section-label">
      Equipo negro
    </p>
    <div class="team-grid">
      <div class="stat-box">
        <strong>{{stats.black.played}}</strong>
        <span>PJ</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.black.wins}}</strong>
        <span>PG</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.black.draws}}</strong>
        <span>PE</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.black.losses}}</strong>
        <span>PP</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.black.winrate}}%</strong>
        <span>WR</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.black.goals}}</strong>
        <span>G</span>
      </div>
      <div class="stat-box">
        <strong>{{stats.black.assists}}</strong>
        <span>A</span>
      </div>
    </div>
  </div>
</div>

{{#if trophies.length}}
<div class="profile-trophies">
  <div class="trophy-category-panel">
    <p class="trophy-category-label">Títulos</p>

    <div class="trophy-podium-grid">
      {{#each trophies}}
      <div class="trophy-podium-card" data-position="{{this.position}}">
        <span class="trophy-podium-medal">
          {{this.medal}}
        </span>

        <span class="trophy-podium-name">
          {{this.type}} {{this.season}}
        </span>

        <span class="trophy-podium-value">
          {{this.value}} {{this.unit}}
        </span>
      </div>
      {{/each}}
    </div>
  </div>
</div>
{{/if}}

<div class="player-matches">
  <div class="section-header">
    <h2 id="matchesTitle">Partidos recientes</h2>
  </div>
  <div id="matchesContainer">
    {{#each matches}}
    <a href="/matches/{{this._id}}" class="match-card match-card-compact player-match-card player-match-card--{{this.playerResult}} player-match-card--side-{{this.playerStats.team}}">
      <div class="match-scoreboard">
        <div class="match-team {{#if (eq this.playerStats.team "A")}}player-match-team--own{{/if}}">
          <span class="match-team-label">Equipo</span>
          <span class="match-team-name">Blanco</span>
          {{#if (eq this.playerStats.team "A")}}
            <div class="player-match-performance">
              <span><span aria-hidden="true">⚽</span> {{this.playerStats.goals}} G</span>
              <span><span aria-hidden="true">🎯</span> {{this.playerStats.assists}} A</span>
            </div>
          {{/if}}
        </div>
        <div class="match-score">
          <div class="match-date">{{formatDate this.date}}</div>
          <span class="match-score-number">{{this.teamA}} — {{this.teamB}}</span>
          {{#if this.venue}}<span class="match-score-meta">{{this.venue}}</span>{{/if}}
          {{#if (eq this.matchType "friendly")}}<span class="badge-friendly">Amistoso</span>{{/if}}
        </div>
        <div class="match-team match-team-right {{#if (eq this.playerStats.team "B")}}player-match-team--own{{/if}}">
          <span class="match-team-label">Equipo</span>
          <span class="match-team-name">Negro</span>
          {{#if (eq this.playerStats.team "B")}}
            <div class="player-match-performance">
              <span><span aria-hidden="true">⚽</span> {{this.playerStats.goals}} G</span>
              <span><span aria-hidden="true">🎯</span> {{this.playerStats.assists}} A</span>
            </div>
          {{/if}}
        </div>
      </div>
    </a>
    {{else}}
        <div class="list-empty-state">
        Sin partidos todavía
        </div>
    {{/each}}
  </div>
  {{#if (gt totalMatches 3)}}
  <button
    id="loadMoreMatches"
    class="btn-yellow"
    data-page="1"
    data-player="{{player._id}}"
    data-season="{{selectedSeason}}"
  >
    Ver más
  </button>
  {{/if}}
</div>

<script>
  window.currentUser = {{{json currentUser}}};
</script>
<script src="/js/playerProfile.js"></script>