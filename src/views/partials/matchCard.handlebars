<article class="match-card matches-list-card" id="match-{{this._id}}">
  <div class="match-scoreboard
  {{#if (gt this.teamA this.teamB)}}scoreboard-win-a
  {{else if (gt this.teamB this.teamA)}}scoreboard-win-b
  {{else}}scoreboard-draw
  {{/if}}">
    <div class="match-card-date">{{formatDate this.date}}{{#if this.venue}} · {{this.venue}}{{/if}}{{#if (eq this.matchType "friendly")}} <span class="badge-friendly">Amistoso</span>{{/if}}</div>
    <div class="match-team">
      <span class="match-team-label">Equipo</span>
      <span class="match-team-name">Blanco</span>
    </div>

    {{#if isDetail}}
    <div class="match-score"><span class="match-score-number">{{this.teamA}} <span class="match-score-divider">—</span> {{this.teamB}}</span></div>
    {{else}}
    <a class="match-score match-score-link" href="/matches/{{this._id}}" aria-label="Ver partido: Blanco {{this.teamA}}, Negro {{this.teamB}}">
      <span class="match-score-number">{{this.teamA}} <span class="match-score-divider">—</span> {{this.teamB}}</span>
    </a>
    {{/if}}

    <div class="match-team match-team-right">
      <span class="match-team-label">Equipo</span>
      <span class="match-team-name">Negro</span>
    </div>
  </div>

  <div class="match-players">
    <div class="match-team-col">
      <div class="player-list-header">
        <span class="player-list-header-name">Blanco</span>
        <div class="player-list-header-stats">
          <span>G</span>
          <span>A</span>
        </div>
      </div>
      <ul class="player-list">
        {{#each this.players}}
          {{#if (eq this.team "A")}}
          <li data-player-id="{{this.player._id}}" data-player-name="{{this.player.name}}" class="player-item {{#if this.player.guest}}player-guest{{/if}}
                {{#if (includes ../mvpPlayers this.player._id)}}player-mvp{{/if}}"
            {{#if @root.user}}
              onclick="voteMVP('{{../_id}}','{{this.player._id}}')"
            {{else}}
              title="Logueate para votar"
              style="cursor: default;"
            {{/if}}>
            <span class="player-item-name {{#if this.ownGoalScorer}}player-owngoal{{/if}}">
              {{#if this.ownGoalScorer}}
                {{this.ownGoalScorer.name}} <span class="player-owngoal-tag">(e/c)</span>
              {{else}}
                {{this.player.name}}
              {{/if}}
              {{#if (gt (getVoteCount ../voteCountByPlayer this.player._id) 0)}}
                <span class="mvp-badge {{#if (includes ../mvpPlayers this.player._id)}}mvp-badge-leader{{/if}}">
                  {{#if (includes ../mvpPlayers this.player._id)}}
                    <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {{/if}}
                  {{getVoteCount ../voteCountByPlayer this.player._id}}
                </span>
              {{/if}}
            </span>
            <div class="player-item-stats">
              <span class="player-stat {{#if (gt this.goals 0)}}stat-active{{/if}}">
                {{this.goals}}
              </span>
              <span class="player-stat {{#if (gt this.assists 0)}}stat-active{{/if}}">
                {{this.assists}}
              </span>
            </div>
          </li>
          {{/if}}
        {{/each}}
      </ul>
    </div>

    <div class="match-team-col">
      <div class="player-list-header">
        <span class="player-list-header-name">Negro</span>
        <div class="player-list-header-stats">
          <span>G</span>
          <span>A</span>
        </div>
      </div>
      <ul class="player-list">
        {{#each this.players}}
          {{#if (eq this.team "B")}}
          <li data-player-id="{{this.player._id}}" data-player-name="{{this.player.name}}" class="player-item {{#if this.player.guest}}player-guest{{/if}}
                {{#if (includes ../mvpPlayers this.player._id)}}player-mvp{{/if}}"
          {{#if @root.user}}
            onclick="voteMVP('{{../_id}}','{{this.player._id}}')"
          {{else}}
            title="Logueate para votar"
            style="cursor: default;"
          {{/if}}>
          <span class="player-item-name {{#if this.ownGoalScorer}}player-owngoal{{/if}}">
            {{#if this.ownGoalScorer}}
              {{this.ownGoalScorer.name}} <span class="player-owngoal-tag">(e/c)</span>
            {{else}}
              {{this.player.name}}
            {{/if}}
            {{#if (gt (getVoteCount ../voteCountByPlayer this.player._id) 0)}}
              <span class="mvp-badge {{#if (includes ../mvpPlayers this.player._id)}}mvp-badge-leader{{/if}}">
                {{#if (includes ../mvpPlayers this.player._id)}}
                  <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                {{/if}}
                {{getVoteCount ../voteCountByPlayer this.player._id}}
              </span>
            {{/if}}
          </span>
          <div class="player-item-stats">
            <span class="player-stat {{#if (gt this.goals 0)}}stat-active{{/if}}">
              {{this.goals}}
            </span>
            <span class="player-stat {{#if (gt this.assists 0)}}stat-active{{/if}}">
              {{this.assists}}
            </span>
          </div>
          </li>
          {{/if}}
        {{/each}}
      </ul>
    </div>
  </div>

  <div class="match-card-footer">
    <div class="footer-left">
      {{#if this.youtubeUrl}}
      <a href="{{this.youtubeUrl}}" target="_blank" class="btn-youtube btn-youtube-full" title="Ver partido completo">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="#ff0000" xmlns="http://www.w3.org/2000/svg">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
      </a>
      {{/if}}
      {{#if this.youtubeHlUrl}}
      <a href="{{this.youtubeHlUrl}}" target="_blank" class="btn-youtube btn-youtube-hl" title="Ver highlight">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="#ffffff" xmlns="http://www.w3.org/2000/svg">
          <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
        </svg>
      </a>
      {{/if}}
      {{#if @root.user}}
        <span class="match-user-vote
          {{#if this.userVotePlayerName}}
            match-user-vote-active
          {{/if}}
        ">
          {{#if this.userVotePlayerName}}
            <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><path d="m12 3 2.8 5.7 6.3.9-4.6 4.5 1.1 6.3-5.6-3-5.6 3 1.1-6.3L2.9 9.6l6.3-.9Z"/></svg><span>MVP: {{this.userVotePlayerName}}</span>
          {{else}}
            Sin voto MVP
          {{/if}}
        </span>
      {{/if}}
    </div>

    <div class="footer-right">
      <button 
        type="button" 
        class="btn-match-action btn-copy"
        onclick="copyMatch('{{this._id}}', event)"
        title="Copiar imagen">
        <svg viewBox="0 0 24 24" width="16" height="16">
          <path d="M16 1H4C2.9 1 2 1.9 2 3v12h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/>
        </svg>
      </button>
      <a href="{{#if isDetail}}/matches{{else}}/matches/{{this._id}}{{/if}}" class="btn-match-action match-open" title="{{#if isDetail}}Ver partidos{{else}}Ver detalle{{/if}}">{{#if isDetail}}Ver partidos{{else}}Ver partido{{/if}}<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10"/></svg></a>
      {{#if (and @root.user (eq @root.user.role "admin"))}}
        <a href="/matches/{{this._id}}/edit{{#if selectedSeason}}?season={{selectedSeason}}{{/if}}" 
          class="btn-match-action btn-edit" 
          title="Editar">
          <svg viewBox="0 0 24 24" width="16" height="16">
            <path d="M3 17.25V21h3.75L19.81 7.94l-3.75-3.75L3 17.25zm2.92 2.33H5v-.92l9.06-9.06.92.92L5.92 19.58zM20.71 6.04a1 1 0 0 0 0-1.41l-1.34-1.34a1 1 0 0 0-1.41 0l-1.13 1.13 2.75 2.75 1.13-1.13z"/>
          </svg>
        </a>
        <button type="button" 
                class="btn-match-action btn-delete" 
                onclick="openDeleteModal('/matches/{{this._id}}/delete')" 
                title="Eliminar">
          <svg viewBox="0 0 448 512" width="16" height="16">
            <path d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z"/>
          </svg> 
        </button>
      {{/if}}
    </div>
  </div>
</article>
