<section class="club-ticker" id="clubTicker" aria-label="Novedades de Toskos FC">
  <span class="club-ticker-label"><span class="club-ticker-dot" aria-hidden="true"></span>TSK</span>
  <div class="club-ticker-viewport" id="clubTickerViewport">
    <div class="club-ticker-track" id="clubTickerTrack">
      <div class="club-ticker-cycle">
        <a href="/stats" class="club-ticker-item"><span class="club-ticker-heading">Toskos FC</span><strong>Partidos · Estadísticas · Títulos</strong></a>
      </div>
    </div>
  </div>
  <button type="button" class="club-ticker-pause" id="clubTickerPause" aria-label="Pausar novedades" aria-pressed="false">
    <svg class="club-ticker-pause-icon" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="M4 3h2v10H4zm6 0h2v10h-2z" /></svg>
    <svg class="club-ticker-play-icon" aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="currentColor"><path d="m5 3 8 5-8 5z" /></svg>
  </button>
</section>
