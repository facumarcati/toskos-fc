<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Montserrat:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/img/escudo-tsk.png" />
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/clubTicker.css" />
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#d4af37">
    <link rel="apple-touch-icon" href="/img/icons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/img/icons/favicon-32.png">
    <title>Toskos FC</title>
  </head>
  <body class="{{#if (eq activePage "/")}}no-scroll-home{{/if}}">
    <header class="site-header">
      {{> clubTicker}}
      <nav class="navbar" aria-label="Navegación principal">
        <div class="nav-brand">
          <a href="/" class="nav-logo" aria-label="Toskos FC — Inicio">
            <img src="/img/escudo-tsk.png" alt="" width="44" height="44" />
            <span class="nav-wordmark">Toskos <span>FC</span></span>
          </a>
          <button type="button" class="nav-hamburger" id="navHamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="navMenu" onclick="toggleMenu()">
            <span></span><span></span><span></span>
          </button>
        </div>
        <div class="nav-menu" id="navMenu">
          <span class="nav-mobile-label">EL CLUB</span>
          <div class="nav-left">
            <a href="/" data-nav-link>Inicio <svg class="nav-link-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
            <a href="/matches" data-nav-link>Partidos <svg class="nav-link-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
            <a href="/stats" data-nav-link>Estadísticas <svg class="nav-link-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
            <a href="/records" data-nav-link>Récords <svg class="nav-link-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
            <a href="/h2h" data-nav-link>H2H <svg class="nav-link-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
            <a href="/trophies" data-nav-link>Títulos <svg class="nav-link-arrow" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
          </div>
          <div class="nav-right" id="navAuth">
            {{#if (eq user.role "admin")}}
              <a href="/matches/new" class="nav-create"><span aria-hidden="true">+</span> Nuevo partido</a>
            {{/if}}
            {{#if user}}
              <div class="profile-wrapper" id="profileWrapper">
                <button type="button" class="nav-account" id="profileBtn" aria-expanded="false" aria-controls="profileMenu">
                  <span class="nav-avatar" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg></span>
                  <span class="nav-account-name">{{user.username}}</span>
                  <svg class="nav-chevron" viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
                </button>
                <div id="profileMenu" class="profile-menu">
                  {{#unless (eq user._id "admin")}}<a href="/profile/{{user.username}}" class="profile-menu-link">Mi perfil</a>{{/unless}}
                  {{#if (eq user.role "admin")}}<a href="/admin/users" class="profile-menu-link">Administrar usuarios</a>{{/if}}
                  <button type="button" id="logoutBtn" class="profile-menu-link">Cerrar sesión</button>
                </div>
              </div>
            {{else}}
              <a href="/login" class="nav-login">Ingresar</a>
              <a href="/register" class="nav-register">Sumarme <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M7 7h10v10" /></svg></a>
            {{/if}}
          </div>
        </div>
      </nav>
    </header>

    <div class="page">
      {{{body}}}
    </div>

    <footer class="page-footer">
      <span>Toskos FC</span>
      <div class="footer-diamond"></div>
      <span>2017-2026</span>
    </footer>

    <div class="modal-overlay" id="deleteModal">
      <div class="modal">
        <p class="modal-title">¿Eliminar partido?</p>
        <p class="modal-desc">Esta acción no se puede deshacer.</p>
        <div class="modal-actions">
          <button
            class="btn-match-action btn-close"
            onclick="closeDeleteModal()"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640">
              <path
                d="M504.6 148.5C515.9 134.9 514.1 114.7 500.5 103.4C486.9 92.1 466.7 93.9 455.4 107.5L320 270L184.6 107.5C173.3 93.9 153.1 92.1 139.5 103.4C125.9 114.7 124.1 134.9 135.4 148.5L278.3 320L135.4 491.5C124.1 505.1 125.9 525.3 139.5 536.6C153.1 547.9 173.3 546.1 184.6 532.5L320 370L455.4 532.5C466.7 546.1 486.9 547.9 500.5 536.6C514.1 525.3 515.9 505.1 504.6 491.5L361.7 320L504.6 148.5z"
              />
            </svg>
          </button>
          <form id="deleteForm" method="POST">
            <button type="submit" class="btn-match-action btn-delete">
              <svg viewBox="0 0 448 512" width="16" height="16">
                <path
                  d="M135.2 17.7L128 32H32C14.3 32 0 46.3 0 64S14.3 96 32 96H416c17.7 0 32-14.3 32-32s-14.3-32-32-32H320l-7.2-14.3C307.4 6.8 296.3 0 284.2 0H163.8c-12.1 0-23.2 6.8-28.6 17.7zM416 128H32L53.2 467c1.6 25.3 22.6 45 47.9 45H346.9c25.3 0 46.3-19.7 47.9-45L416 128z"
                />
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>

    <button
      class="btn-scroll-top"
      id="scrollTop"
      onclick="window.scrollTo({top:0,behavior:'smooth'})"
    >
      ↑
    </button>

    <script src="/js/ui.js"></script>
    <script src="/js/clubTicker.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/realTime.js"></script>
    <script src="/js/auth.js"></script>
  </body>
</html>
