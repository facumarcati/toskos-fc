<link rel="stylesheet" href="/css/stats.css" />
<div class="page-header">
  <span class="eyebrow" id="statsSeasonLabel">
    {{#if (eq selectedSeason "all_time")}}
      Todas las temporadas (Amateur + Profesionalismo)
    {{else if (eq selectedSeason "all")}}
      Todas las temporadas (Profesionalismo)
    {{else}}
      Temporada {{selectedSeason}}
    {{/if}}
  </span>
  <h1>Estadísticas</h1>
</div>

<div class="matches-header">
  <div style="display:flex; gap:8px; align-items:center;">
    <form method="GET" action="/stats" class="season-filter" data-stats-filter-form>
      {{#if includeGuests}}
        <input type="hidden" name="guests" value="1" />
      {{/if}}
      <input
        type="hidden"
        id="selectedSort"
        name="sortBy"
        value="{{selectedSort}}"
      />
      <input
        type="hidden"
        id="selectedOrderDir"
        name="orderDir"
        value="{{selectedOrderDir}}"
      />
      <select name="season" aria-label="Temporada">
        <option value="all_time" {{#if (eq selectedSeason "all_time")}}selected{{/if}}>TODAS (AMAT + PROF)</option>
        <option value="all" {{#if (eq selectedSeason "all")}}selected{{/if}}>TODAS (PROFESIONALISMO)</option>
        <option value="2026" {{#if (eq selectedSeason "2026")}}selected{{/if}}>
          2026
        </option>
        <option value="2025" {{#if (eq selectedSeason "2025")}}selected{{/if}}>
          2025
        </option>
        <option value="2024" {{#if (eq selectedSeason "2024")}}selected{{/if}}>
          2024
        </option>
        <option value="2021" {{#if (eq selectedSeason "2021")}}selected{{/if}}>
          2021
        </option>
      </select>
    </form>
  </div>

  <form method="GET" action="/stats" class="season-filter" data-stats-filter-form>
    <input type="hidden" name="season" value="{{selectedSeason}}" />
    <input type="hidden" name="sortBy" value="{{selectedSort}}" />
    <input type="hidden" name="orderDir" value="{{selectedOrderDir}}" />

    <label class="filter-checkbox">
      <input
        type="checkbox"
        id="toggleGuests"
        name="guests"
        value="1"
        {{#if includeGuests}}checked{{/if}}
      />
      Incluir invitados
    </label>
  </form>
</div>

<div class="stats-feedback" id="statsFeedback" hidden><span role="status" id="statsStatus"></span><button type="button" id="statsRetry" hidden>Reintentar</button></div>
<div id="stats-table">
  <div class="product-list-section">
    <div class="product-list-header">
      <span class="col-num">#</span>
      <span>Jugador</span>

      <span class="sortable-header" data-sort="matches">PJ</span>
      <span class="sortable-header" data-sort="wins">PG</span>
      <span class="sortable-header" data-sort="draws">PE</span>
      <span class="sortable-header" data-sort="losses">PP</span>
      <span class="sortable-header" data-sort="goals">G</span>
      <span class="sortable-header" data-sort="assists">A</span>
      <span class="sortable-header ga-column" data-sort="ga">G+A</span>
    </div>

    <ul class="product-list">
      {{#each stats}}
        <li
          class="product-row stat-row {{#if this.isGuest}}player-guest{{/if}}"
          {{#unless (isEC this.name)}}
            style="cursor:pointer;"
            onclick="window.location='/players/{{this._id}}?season={{../selectedSeason}}'"
          {{/unless}}
        >
          <span class="col-num">{{add @index 1}}</span>
          <div class="col-title">
            <a class="product-row-title stats-player-title">
              <span class="stats-player-name" title="{{this.name}}">{{this.name}}</span>
              {{#if this.titles}}
                <span class="player-titles" role="img" aria-label="{{this.titles}} {{#if (eq this.titles 1)}}título ganado{{else}}títulos ganados{{/if}}" title="{{this.titles}} {{#if (eq this.titles 1)}}título ganado{{else}}títulos ganados{{/if}}">
                  <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M7 3h10v7a5 5 0 0 1-10 0V3Z"/><path d="M7 5H3v4a5 5 0 0 0 5 5v-2a3 3 0 0 1-3-3V7h2V5Zm10 0h4v4a5 5 0 0 1-5 5v-2a3 3 0 0 0 3-3V7h-2V5ZM11 14h2v5h4v2H7v-2h4v-5Z"/></svg>
                  <span aria-hidden="true">{{this.titles}}</span>
                </span>
              {{/if}}
            </a>
          </div>

          <span class="stat-cell">
            {{#if (isEC this.name)}}-{{else}}{{this.matches}}{{/if}}
          </span>
          <span class="stat-cell cell-win">
            {{#if (isEC this.name)}}-{{else}}{{this.wins}}{{/if}}
          </span>
          <span class="stat-cell cell-draw">
            {{#if (isEC this.name)}}-{{else}}{{this.draws}}{{/if}}
          </span>
          <span class="stat-cell cell-loss">
            {{#if (isEC this.name)}}-{{else}}{{this.losses}}{{/if}}
          </span>
          <span class="stat-cell cell-goals">
            {{this.goals}}
          </span>
          <span class="stat-cell cell-assists">
            {{#if (isEC this.name)}}-{{else}}{{this.assists}}{{/if}}
          </span>
          <span class="stat-cell cell-ga ga-column">
            {{#if (isEC this.name)}}-{{else}}{{add this.goals this.assists}}{{/if}}
          </span>
        </li>
      {{else}}
        <li class="list-empty-state">
          Sin estadísticas todavía
        </li>
      {{/each}}
    </ul>
  </div>
</div>

<div class="stats-criteria">
  <p class="stats-criteria-title">Criterios de desempate</p>
  <ul class="stats-criteria-list">
    <li>
      <span class="criteria-label">Goles:</span>
      Goles → Asistencias → Menos partidos
    </li>
    <li>
      <span class="criteria-label">Asistencias:</span>
      Asistencias → Goles → Menos partidos
    </li>
    <li>
      <span class="criteria-label">Victorias:</span>
      Victorias → Menos partidos → Goles → Asistencias
    </li>
    <li>
      <span class="criteria-label">Partidos:</span>
      Partidos → Victorias → Goles → Asistencias
    </li>
  </ul>
</div>

<script src="/js/stats.js"></script>
