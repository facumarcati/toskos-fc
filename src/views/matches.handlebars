<link rel="stylesheet" href="/css/matchesOverview.css" />
<link rel="stylesheet" href="/css/matchCards.css" />
<div class="matches-filter-feedback" id="matchesFilterFeedback" hidden><span role="status" id="matchesFilterStatus"></span><button type="button" id="matchesFilterRetry" hidden>Reintentar</button></div>
<div id="matchesContent">
<div class="page-header">
  <div class="page-header-top">
    <div>
      <span class="eyebrow">
        Historial
        {{#if (eq selectedSeason "all")}}
          - Todas las temporadas
        {{else}}
          {{selectedSeason}}
        {{/if}}
      </span>
      <h1>Partidos</h1>
      <p class="page-header-meta">
        {{matchCount}} {{#if (eq matchCount 1)}}partido{{else}}partidos{{/if}}
      </p>
    </div>
    {{#if matchCount}}
    <section class="matches-overview" aria-label="Balance de partidos, incluidos amistosos" data-wins-a="{{winsA}}" data-draws="{{draws}}" data-wins-b="{{winsB}}" data-goals-a="{{goalsA}}" data-goals-b="{{goalsB}}">
      <div class="matches-ring">
        <svg viewBox="0 0 120 120" aria-hidden="true"><circle class="matches-ring-track" cx="60" cy="60" r="50" fill="none" stroke-width="10"/><g class="matches-ring-segments"></g></svg>
        <div class="matches-ring-center" aria-live="polite" aria-atomic="true"><strong>{{add (add winsA draws) winsB}}</strong><span>Partidos</span></div>
      </div>
      <div class="matches-balance">
        <p class="matches-overview-label">Balance de resultados</p>
        <button type="button" class="matches-balance-row" data-result="0"><span class="matches-balance-name"><i style="--result-color: #f2f3f5" aria-hidden="true"></i>Blanco</span><strong>{{winsA}}</strong><span class="matches-balance-percent"></span></button>
        <button type="button" class="matches-balance-row" data-result="1"><span class="matches-balance-name"><i style="--result-color: #f5c518" aria-hidden="true"></i>Empates</span><strong>{{draws}}</strong><span class="matches-balance-percent"></span></button>
        <button type="button" class="matches-balance-row" data-result="2"><span class="matches-balance-name"><i style="--result-color: #828b97" aria-hidden="true"></i>Negro</span><strong>{{winsB}}</strong><span class="matches-balance-percent"></span></button>
      </div>
      <div class="matches-goals-summary">
        <div class="matches-goals-labels"><span>Blanco <strong>{{goalsA}}</strong></span><span class="matches-goals-total">{{add goalsA goalsB}} goles</span><span><strong>{{goalsB}}</strong> Negro</span></div>
        <div class="matches-goals-bar" role="img" aria-label="Goles de Blanco: {{goalsA}}. Goles de Negro: {{goalsB}}."><span></span><span></span></div>
      </div>
    </section>
    {{/if}}
  </div>
</div>

<div class="matches-header">
  <div class="matches-filters">
    <form method="GET" action="/matches" class="season-filter">
      <input type="hidden" name="order" value="{{selectedOrder}}" />
      <input type="hidden" name="venue" value="{{selectedVenue}}" />
      <select name="season" data-matches-filter aria-label="Temporada">
        <option value="all" {{#if (eq selectedSeason "all")}}selected{{/if}}>Todas las temporadas</option>
        <option value="2026" {{#if (eq selectedSeason "2026")}}selected{{/if}}>2026</option>
        <option value="2025" {{#if (eq selectedSeason "2025")}}selected{{/if}}>2025</option>
        <option value="2024" {{#if (eq selectedSeason "2024")}}selected{{/if}}>2024</option>
        <option value="2021" {{#if (eq selectedSeason "2021")}}selected{{/if}}>2021</option>
      </select>
    </form>

    <form method="GET" action="/matches" class="season-filter matches-month-filter">
      <input type="hidden" name="season" value="{{selectedSeason}}" />
      <input type="hidden" name="order" value="{{selectedOrder}}" />
      <input type="hidden" name="venue" value="{{selectedVenue}}" />
      <select name="month" data-matches-filter aria-label="Mes">
        <option value="">Todos los meses</option>
        {{#each months}}
          <option value="{{this.value}}" {{#if (eq this.value ../selectedMonth)}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </form>

    <form method="GET" action="/matches" class="season-filter">
      <input type="hidden" name="season" value="{{selectedSeason}}" />
      <input type="hidden" name="order" value="{{selectedOrder}}" />
      <input type="hidden" name="month" value="{{selectedMonth}}" />
      <select name="venue" data-matches-filter aria-label="Cancha">
        <option value="">Todas las canchas</option>
        {{#each venues}}
          <option value="{{this}}" {{#if (eq this ../selectedVenue)}}selected{{/if}}>{{this}}</option>
        {{/each}}
      </select>
    </form>

    <form method="GET" action="/matches">
      <input type="hidden" name="season" value="{{selectedSeason}}" />
      <input type="hidden" name="venue" value="{{selectedVenue}}" />
      <input type="hidden" name="order" value="{{#if (eq selectedOrder "asc")}}desc{{else}}asc{{/if}}" />
      <input type="hidden" name="month" value="{{selectedMonth}}" />
      <button type="submit" class="btn-order" title='{{#if (eq selectedOrder "asc")}}Mostrar los partidos más recientes primero{{else}}Mostrar los partidos más antiguos primero{{/if}}' aria-label='{{#if (eq selectedOrder "asc")}}Mostrar los partidos más recientes primero{{else}}Mostrar los partidos más antiguos primero{{/if}}'>
        {{#if (eq selectedOrder "asc")}}↑{{else}}↓{{/if}}
      </button>
    </form>

    {{#if (or selectedVenue selectedMonth)}}
    <a href="/matches?season={{selectedSeason}}&order={{selectedOrder}}" class="btn-clear-filters" data-matches-filter-link>
      ✕ Limpiar
    </a>
    {{/if}}
  </div>

  <div class="matches-toolbar">
    <a href="/matches/new" class="btn-yellow btn-yellow-sm matches-create"><span aria-hidden="true">+</span> Nuevo partido</a>
  </div>
</div>

{{#each matches}}
{{#if this.monthHeading}}
<div class="matches-month-heading">
  <h2>{{this.monthHeading.label}}</h2>
  <span>{{this.monthHeading.count}} {{#if (eq this.monthHeading.count 1)}}partido{{else}}partidos{{/if}}</span>
</div>
{{/if}}
{{> matchCard this selectedSeason=../selectedSeason}}
{{else}}
<div class="list-empty-state" style="text-align:center; padding:80px 20px">
  <p>No hay partidos todavía</p>
  <a href="/matches/new" class="btn-yellow matches-create" style="margin-top:24px; display:inline-flex; width:auto; padding:11px 31px"><span aria-hidden="true">+</span> Nuevo partido</a>
</div>
{{/each}}

</div>
<script src="/js/auth.js"></script>
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js"></script>
<script src="/js/matchesOverview.js"></script>
<script src="/js/matchesFilters.js"></script>
<script src="/js/matchMvp.js"></script>
<script>
async function copyMatch(matchId) {
  const element = document.getElementById(`match-${matchId}`);

  const footer = element.querySelector(".match-card-footer");
  footer.style.display = "none";

  const canvas = await html2canvas(element, {
    scale: 2,
    useCORS: true
  });

  footer.style.display = "flex";

  canvas.toBlob(async (blob) => {
    try {
      await navigator.clipboard.write([
        new ClipboardItem({
          "image/png": blob
        })
      ]);

      showToast("✓ Imagen copiada", "success");
    } catch (err) {
      console.error(err);

      showToast("No se pudo copiar la imagen", "error");
    }
  });
}
</script>
